menu "Albam board"

    config ALBAM_WIFI_SSID
        string "Wi-Fi name baked into the firmware (optional)"
        default ""
        help
            Leave empty to pick the network on the touch screen.
            Put it in sdkconfig.local, never in sdkconfig.defaults (the repository is public).

    config ALBAM_WIFI_PASSWORD
        string "Wi-Fi password baked into the firmware (optional)"
        default ""

    config ALBAM_BRIGHTNESS
        int "Backlight brightness (percent)"
        range 5 100
        default 70

endmenu
